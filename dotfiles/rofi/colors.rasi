* {
    /* Primary — Dragon blue */
    primary: #8BA4B0;
    primary-fixed: #8BA4B0;
    primary-fixed-dim: #8BA4B0;
    on-primary: #0D0C0C;
    on-primary-fixed: #0D0C0C;
    on-primary-fixed-variant: #2D4F67;
    primary-container: #2D4F67;
    on-primary-container: #C5C9C5;

    /* Secondary — Dragon yellow */
    secondary: #C4B28A;
    secondary-fixed: #C4B28A;
    secondary-fixed-dim: #C4B28A;
    on-secondary: #0D0C0C;
    on-secondary-fixed: #0D0C0C;
    on-secondary-fixed-variant: #4A4533;
    secondary-container: #4A4533;
    on-secondary-container: #C5C9C5;

    /* Tertiary — Dragon green */
    tertiary: #87A987;
    tertiary-fixed: #87A987;
    tertiary-fixed-dim: #87A987;
    on-tertiary: #0D0C0C;
    on-tertiary-fixed: #0D0C0C;
    on-tertiary-fixed-variant: #354A3A;
    tertiary-container: #354A3A;
    on-tertiary-container: #C5C9C5;

    /* Error — Dragon red */
    error: #C4746E;
    on-error: #0D0C0C;
    error-container: #43242B;
    on-error-container: #E46876;

    /* Surfaces */
    surface: #181616;
    on-surface: #C5C9C5;
    on-surface-variant: #A6A69C;

    outline: #625E5A;
    outline-variant: #393836;

    shadow: #000000;
    scrim: #000000;

    /* Inverse */
    inverse-surface: #C5C9C5;
    inverse-on-surface: #181616;
    inverse-primary: #6A9589;

    /* Surface hierarchy */
    surface-dim: #0D0C0C;
    surface-bright: #282727;

    surface-container-lowest: #0D0C0C;
    surface-container-low: #181616;
    surface-container: #282727;
    surface-container-high: #393836;
    surface-container-highest: #4A4946;
}
